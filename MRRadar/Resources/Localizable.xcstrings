        }
      }
    },
    "MRRadar follows the projects you pick here. You can change this later in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar folgt den Projekten, die du hier auswählst. Das kannst du später in den Einstellungen ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar sigue los proyectos que elijas aquí. Puedes cambiarlo en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar suit les projets choisis ici. Vous pourrez changer cela dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar segue i progetti che scegli qui. Puoi cambiarli nelle Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadarはここで選んだプロジェクトを追跡します。後から設定で変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar는 여기서 고른 프로젝트를 추적합니다. 나중에 설정에서 바꿀 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O MRRadar acompanha os projetos escolhidos aqui. Você pode mudar isso nos Ajustes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar burada seçtiğiniz projeleri izler. Bunu sonra Ayarlar'dan değiştirebilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar 会跟踪您在此选择的项目。之后可在设置中更改。"
          }
        }
      }
    },
    "MRRadar is not affiliated with RevenueCat.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar steht in keiner Verbindung zu RevenueCat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar no está afiliado a RevenueCat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar n'est pas affilié à RevenueCat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar non è affiliato a RevenueCat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadarはRevenueCatとは提携していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar는 RevenueCat과 제휴 관계가 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O MRRadar não é afiliado ao RevenueCat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar'ın RevenueCat ile bir bağlantısı yoktur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar 与 RevenueCat 无关联。"
          }
        }
      }
    },
    "MRRadar lays out all your RevenueCat apps together, with numbers the dashboard doesn't show: forecasts, month-end pace, MRR quick ratio, implied LTV and alerts.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar zeigt alle deine RevenueCat-Apps zusammen, mit Zahlen, die das Dashboard nicht zeigt: Prognosen, Monatsend-Tempo, Quick Ratio, implizierter LTV und Hinweise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar reúne todas tus apps de RevenueCat con números que el panel no muestra: previsiones, ritmo de fin de mes, quick ratio, LTV implícito y alertas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar réunit toutes vos apps RevenueCat avec des chiffres absents du tableau de bord : prévisions, rythme de fin de mois, quick ratio, LTV implicite et alertes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar riunisce tutte le tue app RevenueCat con numeri che la dashboard non mostra: previsioni, ritmo di fine mese, quick ratio, LTV implicito e avvisi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadarはRevenueCatのアプリをまとめて表示し、ダッシュボードにない数字を示します：予測、月末ペース、クイックレシオ、推定LTV、アラート。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar는 RevenueCat 앱을 한데 모아 대시보드에 없는 숫자를 보여 줍니다: 예측, 월말 속도, 퀵 레이쇼, 추정 LTV, 알림."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O MRRadar reúne todos os seus apps do RevenueCat com números que o painel não mostra: previsões, ritmo de fim de mês, quick ratio, LTV implícito e alertas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar tüm RevenueCat uygulamalarınızı bir araya getirir ve panelin göstermediği rakamları sunar: tahminler, ay sonu hızı, quick ratio, tahmini LTV ve uyarılar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar 汇总您所有的 RevenueCat 应用，并提供控制台没有的数据：预测、月末节奏、快速比率、隐含 LTV 和提醒。"
          }
        }
      }
    },
    "MRRadar lives in your menu bar and reads your numbers in the background. The first full report takes a few minutes, because RevenueCat limits how fast charts can be read.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar lebt in der Menüleiste und liest deine Zahlen im Hintergrund. Der erste Bericht dauert einige Minuten, weil RevenueCat das Lesetempo begrenzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar vive en la barra de menús y lee tus números en segundo plano. El primer informe tarda unos minutos porque RevenueCat limita la velocidad de lectura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar vit dans la barre des menus et lit vos chiffres en arrière-plan. Le premier rapport prend quelques minutes, car RevenueCat limite la vitesse de lecture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar vive nella barra dei menu e legge i tuoi numeri in background. Il primo report richiede qualche minuto perché RevenueCat limita la velocità di lettura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadarはメニューバーに常駐し、バックグラウンドで数字を読み込みます。RevenueCatの速度制限により、最初のレポートには数分かかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar는 메뉴 막대에서 실행되며 백그라운드로 숫자를 읽습니다. RevenueCat의 속도 제한 때문에 첫 보고서는 몇 분 걸립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O MRRadar fica na barra de menus e lê seus números em segundo plano. O primeiro relatório leva alguns minutos, pois o RevenueCat limita a velocidade de leitura."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar menü çubuğunda çalışır ve rakamlarınızı arka planda okur. RevenueCat okuma hızını sınırladığı için ilk rapor birkaç dakika sürer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar 位于菜单栏并在后台读取数据。由于 RevenueCat 限制读取速度，首份报告需要几分钟。"
          }
        }
      }
    },
    "MRRadar reads your data through rc, RevenueCat's official command line tool. It's free and open source.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar liest deine Daten über rc, das offizielle Befehlszeilentool von RevenueCat. Es ist kostenlos und Open Source."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar lee tus datos con rc, la herramienta oficial de línea de comandos de RevenueCat. Es gratis y de código abierto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar lit vos données via rc, l'outil officiel en ligne de commande de RevenueCat. Il est gratuit et open source."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar legge i dati tramite rc, lo strumento ufficiale a riga di comando di RevenueCat. È gratuito e open source."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadarはRevenueCat公式のコマンドラインツールrcでデータを読み取ります。無料のオープンソースです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar는 RevenueCat 공식 명령줄 도구 rc로 데이터를 읽습니다. 무료 오픈 소스입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O MRRadar lê seus dados pelo rc, a ferramenta oficial de linha de comando do RevenueCat. É gratuita e de código aberto."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar verilerinizi RevenueCat'in resmi komut satırı aracı rc ile okur. Ücretsiz ve açık kaynaklıdır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar 通过 RevenueCat 官方命令行工具 rc 读取数据。它免费且开源。"
          }
        }
      }
    },
    "MRRadar tells you about new subscribers, falling MRR, unusual days, refunds and churn. With Remote Code, the same alerts reach your iPhone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar meldet neue Abonnenten, sinkenden MRR, ungewöhnliche Tage, Erstattungen und Churn. Mit Remote Code erreichen dich dieselben Hinweise auf dem iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar te avisa de nuevos suscriptores, caídas de MRR, días inusuales, reembolsos y bajas. Con Remote Code, las mismas alertas llegan a tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar signale nouveaux abonnés, baisse du MRR, jours inhabituels, remboursements et churn. Avec Remote Code, ces alertes arrivent sur votre iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar segnala nuovi abbonati, calo di MRR, giorni insoliti, rimborsi e churn. Con Remote Code gli stessi avvisi arrivano sull'iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadarは新規登録者、MRRの減少、異常な日、返金、解約を通知します。Remote Codeを使えば同じ通知がiPhoneにも届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar는 신규 구독자, MRR 감소, 이례적인 날, 환불, 이탈을 알려 줍니다. Remote Code를 쓰면 같은 알림이 iPhone으로도 옵니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O MRRadar avisa sobre novos assinantes, queda de MRR, dias incomuns, reembolsos e churn. Com o Remote Code, os alertas chegam ao iPhone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar yeni aboneleri, düşen MRR'ı, olağandışı günleri, iadeleri ve abone kaybını bildirir. Remote Code ile aynı uyarılar iPhone'unuza da gelir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar 会提醒新订阅者、MRR 下降、异常日期、退款和流失。配合 Remote Code，同样的提醒也会发送到 iPhone。"
          }
        }
      }
    },
    "MRRadar tells you here when a number moves.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar meldet sich hier, wenn sich eine Zahl bewegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar te avisa aquí cuando cambie un número."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar vous prévient ici quand un chiffre bouge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar ti avvisa qui quando un numero cambia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数字が動くとここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숫자가 움직이면 여기에 알려 드립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O MRRadar avisa aqui quando um número mudar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir rakam değiştiğinde MRRadar burada bildirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数字变化时，MRRadar 会在此提醒您。"
          }
        }
      }
    },
    "MRRadar uses Homebrew if you have it. Otherwise it downloads the official release from GitHub, checks it against the published checksum and keeps it in its own folder.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar nutzt Homebrew, falls vorhanden. Sonst lädt es die offizielle Version von GitHub, prüft die veröffentlichte Prüfsumme und legt sie in einem eigenen Ordner ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar usa Homebrew si lo tienes. Si no, descarga la versión oficial de GitHub, comprueba la suma publicada y la guarda en su carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar utilise Homebrew si vous l'avez. Sinon, il télécharge la version officielle sur GitHub, vérifie la somme publiée et la garde dans son dossier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "MRRadar usa Homebrew se presente. Altrimenti scarica la versione ufficiale da GitHub, verifica il checksum pubblicato e la tiene nella sua cartella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrewがあれば使用します。なければGitHubから公式リリースをダウンロードし、公開チェックサムで検証して専用フォルダに保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew가 있으면 사용합니다. 없으면 GitHub에서 공식 릴리스를 내려받아 공개된 체크섬으로 확인한 뒤 전용 폴더에 둡니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O MRRadar usa o Homebrew, se houver. Caso contrário, baixa a versão oficial do GitHub, confere o checksum publicado e a mantém em sua pasta."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew varsa onu kullanır. Yoksa GitHub'dan resmi sürümü indirir, yayımlanan sağlama toplamıyla doğrular ve kendi klasöründe tutar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如已安装 Homebrew 则使用它。否则从 GitHub 下载官方版本，校验公布的校验和，并保存在专用文件夹中。"
          }
        }
      }
    },
    "Marked days are far from the 28 before them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markierte Tage weichen stark von den 28 Tagen davor ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los días marcados se alejan mucho de los 28 anteriores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jours marqués s'écartent nettement des 28 précédents."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I giorni segnati si discostano molto dai 28 precedenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "印の付いた日は直前28日から大きく外れています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시된 날은 직전 28일과 크게 다릅니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dias marcados destoam dos 28 anteriores."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşaretli günler önceki 28 günden belirgin şekilde farklı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标记的日期明显偏离此前 28 天。"
          }
        }
      }
