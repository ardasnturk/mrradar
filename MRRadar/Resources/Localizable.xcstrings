    "MRR won per unit lost over the last 8 weeks.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewonnener MRR je verlorener Einheit in den letzten 8 Wochen."
          }
        },
        "es": {
