    "Each week: new, returning and upgraded subscribers against those who left.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Woche: neue, zurückgekehrte und hochgestufte Abonnenten gegenüber denen, die gingen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada semana: suscriptores nuevos, recuperados y mejorados frente a los que se fueron."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque semaine : abonnés nouveaux, revenus et passés à l'offre supérieure face à ceux partis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni settimana: abbonati nuovi, tornati e con upgrade contro quelli usciti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎週の新規・復帰・アップグレードの登録者と、離脱した登録者の比較。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매주 신규·복귀·업그레이드 구독자와 이탈 구독자를 비교합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda semana: assinantes novos, recuperados e com upgrade contra os que saíram."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her hafta yeni, dönen ve yükselten aboneler ile ayrılanlar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每周新增、回归和升级的订阅者与流失者的对比。"
          }
        }
      }
    },
