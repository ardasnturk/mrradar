    "%@ is your best day, %@ against an average day.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist dein bester Tag, %2$@ gegenüber einem Durchschnittstag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ es tu mejor día, %2$@ frente a un día medio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ est votre meilleur jour, %2$@ par rapport à un jour moyen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ è il tuo giorno migliore, %2$@ rispetto a un giorno medio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最も良い曜日は%1$@で、平均的な日より%2$@です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 좋은 요일은 %1$@이며 평균 대비 %2$@입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ é seu melhor dia, %2$@ em relação a um dia médio."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En iyi gününüz %1$@, ortalama bir güne göre %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@是您最好的一天，较平均水平 %2$@。"
          }
        }
      }
    },
