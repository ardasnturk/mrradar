          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MRR gagné par unité perdue sur les 8 dernières semaines."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "MRR guadagnato per unità persa nelle ultime 8 settimane."
          }
        },
        "ja": {
