    "%@ of subscribers left this week, %@ above normal.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ der Abonnenten sind diese Woche gegangen, %2$@ über normal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El %1$@ de los suscriptores se fue esta semana, %2$@ por encima de lo normal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ des abonnés sont partis cette semaine, %2$@ au-dessus de la normale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il %1$@ degli abbonati se n'è andato questa settimana, %2$@ sopra la norma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今週は登録者の%1$@が離脱し、通常より%2$@高い水準です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 주 구독자의 %1$@가 이탈했으며 평소보다 %2$@ 높습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ dos assinantes saíram nesta semana, %2$@ acima do normal."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hafta abonelerin %1$@ kadarı ayrıldı, normalin %2$@ üzerinde."
